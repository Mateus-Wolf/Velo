# ============================================================
# Banco de Dados
# ============================================================
DATABASE_URL=postgresql://usuario:senha@localhost:5432/Schedly

# ============================================================
# JWT — Gere uma chave segura com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================
SECRET_KEY=sua-chave-secreta-aqui-troque-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================================
# Email (SMTP via Gmail App Password)
# Crie uma senha de app em: https://myaccount.google.com/apppasswords
# ============================================================
MAIL_FROM=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-app-do-gmail-aqui
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# ============================================================
# Gemini AI (Google AI Studio)
# Gere uma chave em: https://aistudio.google.com/apikey
# ============================================================
GEMINI_API_KEY=sua-chave-api-do-google-ai-studio-aqui

# ============================================================
# Firebase (Push Notifications)
# Baixe o JSON da service account em:
#   Firebase Console > Configurações > Contas de serviço > Gerar nova chave privada
# Cole o conteúdo JSON completo como string na variável abaixo.
# ============================================================
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"SEU_PROJECT_ID",...}
